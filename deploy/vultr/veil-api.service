[Unit]
Description=VEIL FastAPI backend
After=network.target

[Service]
User=veil
Group=www-data
WorkingDirectory=/opt/veil/apps/veil-backend
EnvironmentFile=/opt/veil/apps/veil-backend/.env
ExecStart=/opt/veil/apps/veil-backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
